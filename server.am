// amalgame-live — Mosaic site entry point.
//
// A live audience-participation board: a poll the room votes on and a
// wall of emoji/text reactions, all updating in real time. Built and
// run with Mosaic (`mosaic dev` / `mosaic build`) on the pure-Amalgame
// web stack (router + JSON + static), compiled to a native binary.
//
// Plain HTTP on $PORT (default 8080). TLS is fronted by the host's
// reverse proxy (see deploy/), so the app stays single-threaded and
// dead simple.
//
// The shared data model + file-backed store live here in the entry
// module (rather than a separate file) because `mosaic build` compiles
// `server.am` + the generated `_routes.am` together — and server.am is
// compiled first, so these struct bodies are emitted ahead of the route
// handlers that read their fields.

namespace App

import Amalgame.Collections
import Amalgame.Web
import Amalgame.Net.Http
import Amalgame.Formats.Json
import Amalgame.Threading

public class Program {
    public static int Main(string[] args) {
        var port: int = 8080
        let portEnv: string = Env_Get("PORT")
        if (String_Length(portEnv) > 0) {
            let p: int = String_ToInt(portEnv)
            if (p > 0) { port = p }
        }

        // Optional native TLS termination (no nginx/Caddy in front).
        // Set both TLS_CERT and TLS_KEY (PEM file paths) and the app
        // switches to HTTPS on $port. Default port jumps to 8443 if
        // PORT is not explicitly set and TLS is active.
        let certPath: string = Env_Get("TLS_CERT")
        let keyPath:  string = Env_Get("TLS_KEY")
        let tlsActive: bool  = String_Length(certPath) > 0 && String_Length(keyPath) > 0
        if (tlsActive && String_Length(portEnv) == 0) {
            port = 8443
        }

        let app: WebApp = WebApp.New()
        Routes.Bind(app)

        var scheme: string = "http"
        if (tlsActive) { scheme = "https" }
        Console.WriteLine("amalgame-live — listening on " + scheme + "://0.0.0.0:" + String_FromInt(port))
        Console.WriteLine("  projector : /        (the big screen)")
        Console.WriteLine("  join      : /join    (phones)")
        Console.WriteLine("  state     : /api/state")
        Console.WriteLine("  store     : " + Store.Path())
        if (tlsActive) {
            Console.WriteLine("  cert      : " + certPath)
            Console.WriteLine("  key       : " + keyPath)
        }
        Console.Flush()

        if (tlsActive) {
            // Optional embedded auto-renewal — when ACME_DOMAIN +
            // ACME_EMAIL + ACME_DIR are set, the app self-provisions
            // and self-renews the cert at TLS_CERT via the
            // amalgame-tls v0.3.3 helpers. Same flow as a separate
            // acme-renew CLI + cron, just rolled into the binary so
            // a deploy doesn't need a system cron entry.
            //
            // Renewal needs port 80 free for the http-01 challenge.
            // On hosts where another service holds port 80 (a node
            // greenlock proxy, nginx, …) EnsureCert returns -3 and
            // we log + continue with the existing cert. The renewal
            // thread retries every 24h; once port 80 frees up the
            // next attempt succeeds without restarting the app.
            let acmeDomain: string = Env_Get("ACME_DOMAIN")
            let acmeEmail:  string = Env_Get("ACME_EMAIL")
            let acmeDir:    string = Env_Get("ACME_DIR")
            let autoRenew: bool = String_Length(acmeDomain) > 0
                && String_Length(acmeEmail) > 0
                && String_Length(acmeDir) > 0
            if (autoRenew) {
                var thresholdDays: int = 30
                let threshEnv: string = Env_Get("ACME_RENEW_DAYS")
                if (String_Length(threshEnv) > 0) {
                    let td: int = String_ToInt(threshEnv)
                    if (td > 0) { thresholdDays = td }
                }
                let daysLeft: int = AcmeNative.CertDaysRemaining(certPath)
                Console.WriteLine("  cert valid: " + String_FromInt(daysLeft) + " days (threshold=" + String_FromInt(thresholdDays) + ")")
                Console.WriteLine("  auto-renew: " + acmeDomain + " <" + acmeEmail + "> → " + acmeDir)
                Console.Flush()

                // Startup attempt — only if cert actually needs renewal.
                // We don't gate startup on success: EnsureCert prints
                // its own diagnostic on failure and we proceed to serve.
                if (AcmeNative.NeedsRenewal(certPath, thresholdDays)) {
                    Console.WriteLine("  cert needs renewal — attempting EnsureCert at startup")
                    Console.Flush()
                    let rc: int = AcmeNative.EnsureCert(acmeDomain, acmeEmail, acmeDir, "")
                    if (rc != 0) {
                        Console.WriteError("  EnsureCert failed (rc=" + String_FromInt(rc) + ") — continuing with existing cert")
                    } else {
                        Console.WriteLine("  EnsureCert OK — serving the renewed cert")
                    }
                    Console.Flush()
                }

                // Background renewal thread — polls every 24h.
                let renewer = (arg: int) => {
                    while (true) {
                        Threading.ThreadSleep(86400000)  // 24h in ms
                        if (AcmeNative.NeedsRenewal(certPath, thresholdDays)) {
                            Console.WriteLine("auto-renew: cert needs renewal, calling EnsureCert")
                            Console.Flush()
                            let rcr: int = AcmeNative.EnsureCert(acmeDomain, acmeEmail, acmeDir, "")
                            if (rcr != 0) {
                                Console.WriteError("auto-renew: EnsureCert failed (rc=" + String_FromInt(rcr) + ") — will retry in 24h")
                            } else {
                                Console.WriteLine("auto-renew: cert renewed OK")
                                Console.WriteError("auto-renew: NOTE the running TLS context still holds the OLD cert; restart the service to load the new one")
                            }
                            Console.Flush()
                        }
                    }
                    return 0
                }
                Threading.ThreadSpawn(renewer, 0)
            }

            // Optional HTTP → HTTPS redirector on a separate port.
            // Set REDIRECT_PORT (e.g. 8080) and a background thread
            // spawns a tiny plain-HTTP listener that emits 301s to
            // the HTTPS URL — same shape any "normal" site has.
            let redirEnv: string = Env_Get("REDIRECT_PORT")
            if (String_Length(redirEnv) > 0) {
                let redirPort: int = String_ToInt(redirEnv)
                if (redirPort > 0) {
                    let httpsPort: int = port
                    let handler = conn => {
                        let req: HttpRequest = HttpRequest.FromH1Conn(conn)
                        let hostHdr: string = req.Header("Host")
                        var host: string = hostHdr
                        let colon: int = String_IndexOf(hostHdr, ":")
                        if (colon >= 0) {
                            host = String_Substring(hostHdr, 0, colon)
                        }
                        if (String_Length(host) == 0) { host = "demo.amalgame.me" }
                        let target: string = "https://" + host + ":" + String_FromInt(httpsPort) + req.RawTarget
                        // 308 = permanent + preserve method (POST stays
                        // POST). Requires net-http v0.11.1+ — earlier
                        // versions silently dropped the Location header
                        // because WriteToH1Conn only emitted Content-Type.
                        HttpResponse.New()
                            .Redirect(target, true)
                            .WriteToH1Conn(conn)
                        return 0
                    }
                    let redirector = (arg: int) => {
                        let cfg = HttpServerConfig.Default()
                        Http1.ServeWith(redirPort, cfg, handler)
                        return 0
                    }
                    Threading.ThreadSpawn(redirector, 0)
                    Console.WriteLine("  redirect  : http://0.0.0.0:" + String_FromInt(redirPort) + " → https://*:" + String_FromInt(httpsPort))
                    Console.Flush()
                }
            }

            // Native TLS via amalgame-web v0.14+ / amalgame-tls. No
            // keep-alive tuning available on the HTTPS path today; the
            // systemd watchdog (amalgame-live-watchdog.timer) catches
            // any long-running stall by restarting the service.
            return app.ServeHttps(port, certPath, keyPath)
        }

        // Plain HTTP behind a reverse proxy. ServeWith + Default
        // config (idle_timeout_sec=0) → keep-alive disabled, one
        // request per connection. The single-threaded serial Serve
        // had a head-of-line stall on long-lived keep-alive
        // connections from the proxy (backlog 64 saturated after
        // ~9h). Closing after each request makes the serial loop
        // self-cleaning, no extra concurrency needed.
        let cfg = HttpServerConfig.Default()
        return app.ServeWith(port, cfg)
    }
}

// ── Data model ────────────────────────────────────────────────────

// One poll option and its running tally.
public class PollOption {
    public Label: string
    public Votes: int
    public PollOption(string label, int votes) {
        this.Label = label
        this.Votes = votes
    }
}

// One reaction posted from the room (an emoji + an optional message).
public class Reaction {
    public Emoji: string
    public Text:  string
    public Reaction(string emoji, string text) {
        this.Emoji = emoji
        this.Text  = text
    }
}

// The whole live board: the poll question, its options, and the
// rolling wall of reactions (newest last).
public class LiveState {
    public Question: string
    public Options:  List<PollOption>
    public Messages: List<Reaction>
    public LiveState() {
        this.Question = ""
        this.Options  = new List<PollOption>()
        this.Messages = new List<Reaction>()
    }
}

// ── File-backed store ─────────────────────────────────────────────
//
// Why a file and not in-memory statics? amc has no mutable static
// fields, and route handlers are independent static methods that can't
// capture a shared object. A tiny JSON file is the simplest store that
// survives a restart — and the server runs single-threaded
// (WebApp.Serve), so every request is a safe read-modify-write with no
// locking needed.

public class Store {
    // Keep the wall bounded so the file (and the projector) stay light.
    public static int MaxMessages() { return 60 }

    public static string Path() {
        let p: string = Env_Get("STATE_FILE")
        if (String_Length(p) > 0) { return p }
        return "/tmp/amalgame-live-state.json"
    }

    // Fresh board used on first boot or after a reset.
    public static LiveState Default() {
        let s = new LiveState()
        s.Question = "Amalgame, votre première impression ?"
        s.Options.Add(new PollOption("Prometteur", 0))
        s.Options.Add(new PollOption("Curieux", 0))
        s.Options.Add(new PollOption("Sceptique", 0))
        s.Options.Add(new PollOption("J'adore", 0))
        return s
    }

    // Read + parse the state file; fall back to Default() on any
    // problem (missing file, bad JSON) so the demo never hard-fails.
    public static LiveState Load() {
        let path: string = Store.Path()
        if (!File_Exists(path)) { return Store.Default() }
        let raw: string = File_ReadAll(path)
        if (String_Length(raw) == 0) { return Store.Default() }

        let parser = new JsonParser(raw)
        let root: JsonValue = parser.ParseTopLevel()
        if (parser.HasFailed()) { return Store.Default() }
        if (!root.IsObject())   { return Store.Default() }

        let s = new LiveState()
        s.Question = root.Get("question").AsString()

        let opts: JsonValue = root.Get("options")
        if (opts.IsArray()) {
            let n: int = opts.Length()
            for i in 0..n {
                let o: JsonValue = opts.At(i)
                s.Options.Add(new PollOption(
                    o.Get("label").AsString(),
                    o.Get("votes").AsInt()))
            }
        }
        if (s.Options.Count() == 0) { return Store.Default() }

        let msgs: JsonValue = root.Get("messages")
        if (msgs.IsArray()) {
            let m: int = msgs.Length()
            for j in 0..m {
                let r: JsonValue = msgs.At(j)
                s.Messages.Add(new Reaction(
                    r.Get("emoji").AsString(),
                    r.Get("text").AsString()))
            }
        }
        return s
    }

    public static void Save(LiveState s) {
        File_WriteAll(Store.Path(), Store.ToJson(s))
    }

    // Minimal JSON string escaping: backslash, double-quote, and the
    // two whitespace controls that would break a one-line value.
    public static string Esc(string v) {
        var r: string = String_Replace(v, "\\", "\\\\")
        r = String_Replace(r, "\"", "\\\"")
        r = String_Replace(r, "\n", " ")
        r = String_Replace(r, "\t", " ")
        return r
    }

    // Serialize by hand (keys in a fixed order) — no JsonValue tree to
    // build, and the output is exactly what /api/state returns.
    public static string ToJson(LiveState s) {
        var out: string = "{\"question\":\"" + Store.Esc(s.Question) + "\",\"options\":["
        let no: int = s.Options.Count()
        for i in 0..no {
            let o: PollOption = s.Options.Get(i)
            if (i > 0) { out = out + "," }
            out = out + "{\"label\":\"" + Store.Esc(o.Label)
                + "\",\"votes\":" + String_FromInt(o.Votes) + "}"
        }
        out = out + "],\"messages\":["
        let nm: int = s.Messages.Count()
        for j in 0..nm {
            let r: Reaction = s.Messages.Get(j)
            if (j > 0) { out = out + "," }
            out = out + "{\"emoji\":\"" + Store.Esc(r.Emoji)
                + "\",\"text\":\"" + Store.Esc(r.Text) + "\"}"
        }
        out = out + "]}"
        return out
    }
}
